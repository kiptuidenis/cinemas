# ==============================================================================
# Cinema Management Platform — .gitignore
# ==============================================================================

# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
env.bak/
venv.bak/
*.sqlite3
*.sqlite3-journal
*.db
local_db/
media/
staticfiles/
collected_static/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
*.lcov
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
*.local
.cache/

# Playwright / E2E Testing
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Docker
.docker/

# IDE & Operating System
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
